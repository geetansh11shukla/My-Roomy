# ==============================================================================
# RoomWala 2.0 Backend Configuration Specification (.env.example)
# Do NOT store actual secrets in source control. Use Google Secret Manager or Firebase Config.
# ==============================================================================

# Node Runtime & Environment
NODE_ENV=development # development | staging | production
PORT=8080

# Firebase / Google Cloud Project
FIREBASE_PROJECT_ID=roomwala-dev
FIREBASE_STORAGE_BUCKET=roomwala-dev.appspot.com
FIREBASE_REGION=asia-south1

# Payment Gateway (Razorpay)
RAZORPAY_MODE=sandbox # sandbox | live
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=rzp_test_placeholder_secret
RAZORPAY_WEBHOOK_SECRET=rzp_test_placeholder_webhook_secret

# WhatsApp Business Platform (Meta Cloud API)
WHATSAPP_API_VERSION=v19.0
WHATSAPP_PHONE_NUMBER_ID=100000000000000
WHATSAPP_CLOUD_API_TOKEN=EAA...placeholder_system_user_token
WHATSAPP_WEBHOOK_VERIFY_TOKEN=roomwala_wa_verify_token_3829

# Identity & Age Verification Provider (HyperVerge / DigiLocker)
VERIFICATION_PROVIDER=mock # mock | hyperverge | digilocker
HYPERVERGE_APP_ID=placeholder_hyperverge_app_id
HYPERVERGE_APP_KEY=placeholder_hyperverge_app_key

# Google Maps / Geospatial Provider
GOOGLE_MAPS_API_KEY=AIzaSy...placeholder_maps_api_key

# Support & Notifications Configuration
SUPPORT_EMAIL=support@roomwala.in
SUPPORT_PHONE=+918000000000

# Feature Flags & Platform Policies
FEATURE_ZERO_BROKERAGE_GUARANTEE=true
FEATURE_STAY_EXTENSION_PRIORITY=true
FEATURE_KEYLESS_PIN_ACCESS=true
HOLD_DURATION_MINUTES=10
DEFAULT_CURRENCY=INR
MIN_BOOKING_ADVANCE_HOURS=2
MAX_NOTIFICATION_RETRIES=3
