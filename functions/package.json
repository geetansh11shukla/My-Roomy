{
  "name": "roomwala-functions",
  "version": "2.0.0",
  "description": "RoomWala Firebase Cloud Functions (TypeScript, Node.js)",
  "engines": {
    "node": "20"
  },
  "main": "lib/index.js",
  "scripts": {
    "lint": "tsc --noEmit",
    "build": "tsc",
    "test": "vitest run src/test",
    "test:watch": "vitest",
    "serve": "npm run build && firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^18.0.9",
    "express": "^4.19.2",
    "firebase-admin": "^12.6.0",
    "firebase-functions": "^5.0.1",
    "nodemailer": "^10.3.1",
    "razorpay": "^2.9.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.7",
    "@types/nodemailer": "^8.0.2",
    "typescript": "^5.4.5",
    "vitest": "^1.5.0"
  },
  "private": true
}
